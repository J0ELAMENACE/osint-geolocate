def _run_picarta(path, picarta_key, country):
    console.print(Rule("[dim]Picarta AI[/dim]", style="dim"))
    candidates = picarta_geolocate(path, picarta_key, top_k=5)
    weak = not candidates or all(
        normalize_confidence(c["confidence"]) < WEAK_CONFIDENCE_PCT for c in candidates
    )
    if country and weak:
        console.print(f"[dim]Résultats faibles — relance avec hint {escape(country)}...[/dim]")
        retried = picarta_geolocate(path, picarta_key, top_k=5, country_code=country)
        if retried:
            candidates = retried
    if candidates:
        best = candidates[0]
        ps("PICARTA", f"Top 1 : {best.get('city','')}, {best.get('country','')} "
                      f"({normalize_confidence(best['confidence'])}%)", "bright_green")
        ps("PICARTA", f"Coords : {best['lat']:.5f}, {best['lon']:.5f}", "bright_green")
        for i, c in enumerate(candidates[1:], 2):
            ps("PICARTA", f"Top {i} : {c.get('city','')}, {c.get('country','')} "
                          f"({normalize_confidence(c['confidence'])}%)", "dim green")
    else:
        ps("PICARTA", "Aucun résultat", "yellow")
    console.print()
    return candidates


def _run_ocr(image_b64, model):
    console.print(Rule(f"[dim]Passe 1/3 -- OCR ({escape(model)})[/dim]", style="dim"))
    try:
        raw = ollama_call(model, PROMPT_OCR, image_b64)
    except (requests.exceptions.RequestException, ValueError) as e:
        log.warning("Passe OCR échouée: %s", e)
        console.print()
        return {}
    result = parse_response(raw)
    text = result.get("all_text_visible", "")
    codes = result.get("codes_numbers", [])
    if not is_empty(text):
        ps("OCR", f"Texte  : {str(text)[:200]}", "bright_yellow")
    if codes:
        ps("OCR", f"Codes  : {', '.join(str(c) for c in codes[:10])}", "bright_yellow")
    language = result.get("language_of_text", "")
    if not is_empty(language):
        ps("OCR", f"Langue : {language}", "bright_yellow")
    console.print("[dim]OK Passe OCR[/dim]")
    console.print()
    return result


def _run_geo(image_b64, model, ocr_result):
    console.print(Rule(f"[dim]Passe 2/3 -- Indices geo ({escape(model)})[/dim]", style="dim"))
    try:
        context = json.dumps(ocr_result, ensure_ascii=False)[:1500]
        raw = ollama_call(model, PROMPT_GEO.replace("{context}", context), image_b64)
    except (requests.exceptions.RequestException, ValueError) as e:
        log.warning("Passe GEO échouée: %s", e)
        console.print()
        return {}
    result = parse_response(raw)
    landmarks = result.get("landmarks", [])
    if landmarks:
        top = sorted(landmarks, key=lambda x: x.get("confidence", 0), reverse=True)[:3]
        ps("GEO", "Landmarks : " + ", ".join(
            f"{l.get('name','?')} ({normalize_confidence(l.get('confidence', 0))}%)" for l in top), "green")
    infra = result.get("infrastructure", {})
    if isinstance(infra, dict):
        for key, label in (("pavement_color", "Trottoir"), ("license_plates", "Plaques")):
            value = infra.get(key, "")
            if not is_empty(value):
                ps("GEO", f"{label} : {value}", "green")
    arch = result.get("architecture", {})
    if isinstance(arch, dict) and not is_empty(arch.get("style", "")):
        ps("GEO", f"Archi : {arch['style']}", "green")
    flags = result.get("flags_emblems", "")
    if not is_empty(flags):
        ps("GEO", f"Drapeaux : {flags}", "bright_green")
    est_city = result.get("estimated_city", "")
    est_country = result.get("estimated_country", "")
    if not is_empty(est_city) or not is_empty(est_country):
        ps("GEO", f"Estimation : {est_city}, {est_country}", "bright_green")
    console.print("[dim]OK Passe GEO[/dim]")
    console.print()
    return result


def _run_web_search(ocr_result, geo_result, country):
    console.print(Rule("[dim]Recherche web DDG[/dim]", style="dim"))
    results = []
    codes = ocr_result.get("codes_numbers", [])
    visible_text = ocr_result.get("all_text_visible", "") or ""
    all_codes = list(set(
        [str(c) for c in codes] + re.findall(r"[A-Z0-9]{6,}", str(visible_text).upper())
    ))
    location_hint = country or ""
    for code in all_codes[:2]:
        console.print(f'[dim]DDG : "{escape(code)}"...[/dim]')
        query = " ".join(filter(None, [f'"{code}"', location_hint, "localisation"]))
        hits = web_search(query, max_results=3)
        if hits:
            results.append({"query": code, "hits": [
                {"title": h.get("title", ""), "snippet": h.get("body", "")} for h in hits]})
        time.sleep(0.5)
    est_city = geo_result.get("estimated_city", "") or ""
    est_country = geo_result.get("estimated_country", "") or ""
    if not is_empty(est_city) and not is_empty(est_country):
        query = f"{est_city} {est_country} géographie localisation"
        hits = web_search(query, max_results=3)
        if hits:
            results.append({"query": query, "hits": [
                {"title": h.get("title", ""), "snippet": h.get("body", "")} for h in hits]})
    console.print()
    return results


def _run_nominatim(geo_result):
    est_city = geo_result.get("estimated_city", "") or ""
    est_country = geo_result.get("estimated_country", "") or ""
    if is_empty(est_city) and is_empty(est_country):
        return None, None
    parts = [p for p in (est_city, est_country) if not is_empty(p)]
    query = ", ".join(parts)
    console.print(f'[dim]Nominatim : "{escape(query)}"...[/dim]')
    nom_lat, nom_lon, nom_name = nominatim_geocode(query)
    if nom_lat is not None:
        ps("NOMINATIM", f"{(nom_name or query)[:80]}", "magenta")
        ps("NOMINATIM", f"{nom_lat:.5f}, {nom_lon:.5f}", "magenta")
    console.print()
    return nom_lat, nom_lon


def _run_reasoning(model, ocr_result, geo_result, picarta_candidates, web_results):
    console.print(Rule(f"[dim]Passe 3/3 -- Raisonnement ({escape(model)})[/dim]", style="dim"))
    try:
        picarta_str = json.dumps(picarta_candidates[:3], ensure_ascii=False) if picarta_candidates else "Aucun"
        web_str = json.dumps(web_results, ensure_ascii=False)[:2000] if web_results else "Aucun"
        ocr_str = json.dumps({k: v for k, v in ocr_result.items()
                              if k in ("all_text_visible", "codes_numbers",
                                       "language_of_text", "description")},
                             ensure_ascii=False)
        geo_str = json.dumps({k: v for k, v in geo_result.items()
                              if k in ("landmarks", "architecture", "infrastructure",
                                       "flags_emblems", "estimated_country",
                                       "estimated_city", "estimated_region", "cultural_clues")},
                             ensure_ascii=False)
        prompt = (PROMPT_REASONING
                  .replace("{ocr}", ocr_str)
                  .replace("{geo}", geo_str)
                  .replace("{picarta}", picarta_str)
                  .replace("{web}", web_str))
        raw = ollama_call(model, prompt, timeout=REASONING_TIMEOUT)
    except (requests.exceptions.RequestException, ValueError) as e:
        log.warning("Passe raisonnement échouée: %s", e)
        console.print()
        return {}
    result = parse_response(raw)
    confidence = result.get("confidence", "")
    color = {"high": "bright_green", "medium": "yellow", "low": "red"}.get(confidence, "white")
    ps("FINAL", f"Confiance : {confidence.upper() if confidence else '?'}", color)
    key_evidence = result.get("key_evidence", [])
    if key_evidence:
        ps("FINAL", f"Preuves   : {', '.join(str(e) for e in key_evidence[:4])}", "cyan")
    reason = result.get("reasoning", "")
    if reason and len(str(reason)) < 400:
        ps("FINAL", f"Analyse   : {reason}", "dim cyan")
    console.print("[dim]OK Raisonnement[/dim]")
    console.print()
    return result


def run_pipeline(path, models, picarta_key=None, no_search=False, country=None):
    if not ollama_ping():
        console.print(f"[red]Ollama non accessible sur {escape(OLLAMA_HOST)}[/red]")
        sys.exit(1)
    image_b64 = image_to_b64(path)

    if picarta_key:
        picarta_candidates = _run_picarta(path, picarta_key, country)
    else:
        console.print("[dim]Picarta désactivé -- définissez PICARTA_API_KEY (gratuit : picarta.ai)[/dim]")
        console.print()
        picarta_candidates = []

    ocr_result = _run_ocr(image_b64, models.ocr)
    geo_result = _run_geo(image_b64, models.geo, ocr_result)

    web_results = []
    if DDG_AVAILABLE and not no_search:
        web_results = _run_web_search(ocr_result, geo_result, country)

    nom_lat, nom_lon = _run_nominatim(geo_result)
    reasoning_result = _run_reasoning(models.reasoning, ocr_result, geo_result,
                                      picarta_candidates, web_results)

    return ocr_result, geo_result, reasoning_result, picarta_candidates, nom_lat, nom_lon


