    lat = _safe_float(reasoning.get("final_lat"))
    lon = _safe_float(reasoning.get("final_lon"))
    if lat is not None and lon is not None:
        return lat, lon, "raisonnement IA"
    lat = _safe_float(geo.get("estimated_lat"))
    lon = _safe_float(geo.get("estimated_lon"))
    if lat is not None and lon is not None:
        return lat, lon, "modèle GEO"
    for candidate in picarta_candidates:
        conf = normalize_confidence(candidate.get("confidence", 0))
        if conf > GOOD_CONFIDENCE_PCT and candidate.get("lat") is not None and candidate.get("lon") is not None:
            return candidate["lat"], candidate["lon"], f"Picarta ({conf}%)"
    if nom_lat is not None and nom_lon is not None:
        return nom_lat, nom_lon, "Nominatim"
    if picarta_candidates and picarta_candidates[0].get("lat") is not None:
        best = picarta_candidates[0]
        return best["lat"], best["lon"], "Picarta"
    return None, None, ""


def print_alternatives(alternatives, title):
    if not alternatives:
        return
    console.print(Rule(f"[dim]{escape(title)}[/dim]", style="dim"))
    for i, alt in enumerate(alternatives[:5], 1):
        alat = _safe_float(alt.get("lat"))
        alon = _safe_float(alt.get("lon"))
        default_label = ", ".join(p for p in (alt.get("city", ""), alt.get("country", "")) if p).strip(", ")
        alabel = alt.get("label") or default_label
        reason = alt.get("reason") or alt.get("evidence", "")
        console.print(f"  [bold cyan][{i}][/bold cyan] {escape(str(alabel))}")
        if reason:
            console.print(f"     [dim]{escape(str(reason)[:100])}[/dim]")
        if alat is not None and alon is not None:
            console.print(f"     [dim blue underline]https://maps.google.com/?q={alat:.5f},{alon:.5f}[/dim blue underline]")
            console.print(f"     [dim green underline]https://www.google.com/maps/@?api=1&map_action=pano&viewpoint={alat:.5f},{alon:.5f}[/dim green underline]")
    console.print()


def print_result(lat, lon, label, source="", alternatives=None):
    maps_url = f"https://maps.google.com/?q={lat:.6f},{lon:.6f}"
    osm_url = f"https://www.openstreetmap.org/?mlat={lat:.6f}&mlon={lon:.6f}&zoom=16"
    sv_url = f"https://www.google.com/maps/@?api=1&map_action=pano&viewpoint={lat:.6f},{lon:.6f}"
    yandex = "https://yandex.com/images/search?rpt=imageview"
    src = f"  [dim]({escape(source)})[/dim]" if source else ""
    console.print(Panel(
        f"[bold bright_green]-> {escape(label)}[/bold bright_green]{src}\n"
        f"[white]   {abs(lat):.5f} {'N' if lat >= 0 else 'S'},  {abs(lon):.5f} {'E' if lon >= 0 else 'W'}[/white]",
        box=box.DOUBLE_EDGE, style="bright_green", padding=(0, 2)
    ))
    console.print()
    for label_text, url, color in (
        ("MAPS       ", maps_url, "bright_blue"),
        ("OSM        ", osm_url, "bright_cyan"),
        ("STREET VIEW", sv_url, "bright_green"),
        ("YANDEX     ", yandex, "yellow"),
    ):
        t = Text()
        t.append(f"[{label_text}]  ", style=f"bold {color}")
        t.append(url, style=f"{color} underline")
        console.print(t)
    console.print()
    print_alternatives(alternatives, "Positions alternatives")
    console.print("[dim]  Yandex -> glisser-deposer la photo pour reverse image search[/dim]")
    console.print()


@click.command()
@click.argument("image", type=click.Path(exists=True, readable=True, dir_okay=False, path_type=Path))
@click.option("--no-solar", is_flag=True, default=False, help="Désactiver calcul solaire")
@click.option("--no-search", is_flag=True, default=False, help="Désactiver recherche DDG")
@click.option("--country", default=None, help="Indice pays (nom ou code) pour Picarta et DDG")
@click.option("--ocr-model", default=DEFAULT_OCR_MODEL, help="Modèle OCR ollama")
@click.option("--geo-model", default=DEFAULT_GEO_MODEL, help="Modèle GEO ollama")
@click.option("--reas-model", default=DEFAULT_REAS_MODEL, help="Modèle RAISONNEMENT ollama")
@click.option("-v", "--verbose", is_flag=True, default=False, help="Logs détaillés (debug)")
def main(image, no_solar, no_search, country, ocr_model, geo_model, reas_model, verbose):
    """
    OSINT image geolocation v3 -- Pipeline multi-modeles + Picarta.

    \b
    Pipeline :
      EXIF -> Picarta -> OCR -> GEO -> DDG -> Nominatim -> RAISONNEMENT -> Solar

    \b
    Cle Picarta gratuite (10 credits) : https://picarta.ai
    La cle se fournit uniquement via la variable d'environnement :
      export PICARTA_API_KEY="votre_cle"

    \b
    Exemples:
      osint-geolocate photo.jpg
      PICARTA_API_KEY=xxx osint-geolocate photo.jpg
      osint-geolocate photo.jpg --country France
    """
    setup_logging(verbose)
    picarta_key = os.environ.get("PICARTA_API_KEY")
    models = Models(ocr=ocr_model, geo=geo_model, reasoning=reas_model)
    path = image
    validate_image(path)

    console.print()
    console.print(Panel(
        f"[bold white]OSINT-GEOLOCATE v3[/bold white]  [dim]{escape(path.name)}[/dim]\n"
        f"[dim]OCR:{escape(models.ocr)}  GEO:{escape(models.geo)}  RAIS:{escape(models.reasoning)}[/dim]",
        box=box.DOUBLE_EDGE, style="bright_blue", padding=(0, 2)
    ))
    console.print()

    lat, lon, timestamp = extract_exif(path)
    if lat is not None and lon is not None:
        ps("EXIF", f"GPS trouve : {lat:.6f}, {lon:.6f}", "bright_cyan")
        if timestamp:
            ps("EXIF", f"Timestamp  : {timestamp.strftime('%Y-%m-%d %H:%M:%S')}", "bright_cyan")
        console.print()
        print_result(lat, lon, "Coordonnees EXIF", "GPS")
        return
    ps("EXIF", "Aucune donnee GPS", "yellow")
    if timestamp:
        ps("EXIF", f"Timestamp : {timestamp.strftime('%Y-%m-%d %H:%M:%S')}", "dim yellow")
    console.print()

    ocr, geo, reasoning, picarta_cands, nom_lat, nom_lon = run_pipeline(
        path, models, picarta_key=picarta_key, no_search=no_search, country=country
    )

    final_lat, final_lon, source = best_coords(reasoning, geo, picarta_cands, nom_lat, nom_lon)

    if not no_solar and timestamp and final_lat is not None:
        ps("SOLAR", solar_analysis(final_lat, final_lon, timestamp), "magenta")
        console.print()

    alternatives = list(reasoning.get("alternative_locations", []) or [])
    for candidate in picarta_cands[1:4]:
        conf = normalize_confidence(candidate.get("confidence", 0))
        alternatives.append({
            "label": f"{candidate.get('city','')}, {candidate.get('country','')}",
            "lat": candidate["lat"], "lon": candidate["lon"],
            "reason": f"Picarta ({conf}%)",
        })

    city = reasoning.get("final_city") or geo.get("estimated_city") or ""
    country_out = reasoning.get("final_country") or geo.get("estimated_country") or ""
    region = reasoning.get("final_region") or geo.get("estimated_region") or ""
    label = ", ".join(filter(None, [city, country_out or region])) or "Estimation IA"

    if final_lat is not None:
        print_result(final_lat, final_lon, label, source, alternatives=alternatives)
    else:
        console.print(Panel(
            "[yellow]Coordonnees non determinees.[/yellow]\n"
            f"[dim]Region estimee : {escape(label) or 'Inconnue'}[/dim]\n\n"
            "[white]-> Reverse image search :[/white]\n"
            "[yellow underline]https://yandex.com/images/search?rpt=imageview[/yellow underline]",
            box=box.ROUNDED, style="yellow"
        ))
        print_alternatives(alternatives, "Positions candidates")
        console.print()


if __name__ == "__main__":
    main()
