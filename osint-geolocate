def is_empty(value):
    return value is None or str(value).strip().lower() in EMPTY_VALUES


def normalize_confidence(conf):
    value = _safe_float(conf)
    if value is None:
        return 0
    if value <= 1.0:
        value *= 100
    return int(round(value))


def _safe_float(value):
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


def _safe_int(value):
    try:
        return int(value)
    except (TypeError, ValueError):
        return 0


def http_request(method, url, **kwargs):
    last_error = None
    for attempt in range(HTTP_RETRIES + 1):
        try:
            response = requests.request(method, url, **kwargs)
            response.raise_for_status()
            return response
        except requests.exceptions.HTTPError:
            raise
        except requests.exceptions.RequestException as e:
            last_error = e
            log.debug("Tentative %d/%d échouée pour %s: %s",
                      attempt + 1, HTTP_RETRIES + 1, url, e)
            time.sleep(0.5 * (attempt + 1))
    raise last_error


def validate_image(path):
    size = path.stat().st_size
    if size == 0:
        raise click.ClickException(f"Fichier vide : {path}")
    if size > MAX_IMAGE_BYTES:
        raise click.ClickException(
            f"Image trop volumineuse ({size / 1024 / 1024:.1f} Mo, "
            f"max {MAX_IMAGE_BYTES // 1024 // 1024} Mo)"
        )
    try:
        with Image.open(path) as img:
            img.verify()
    except (UnidentifiedImageError, OSError) as e:
        raise click.ClickException(f"Fichier image invalide : {path} ({e})")


def dms_to_decimal(dms, ref):
    try:
        d, m, s = float(dms[0]), float(dms[1]), float(dms[2])
    except (TypeError, ValueError, IndexError, ZeroDivisionError) as e:
        log.debug("Conversion DMS impossible: %s", e)
        return None
    value = d + m / 60.0 + s / 3600.0
    return -value if ref in ("S", "W") else value


def extract_exif(path):
    try:
        with Image.open(path) as img:
            exif_data = img._getexif()
    except (UnidentifiedImageError, OSError, AttributeError) as e:
        log.warning("Lecture EXIF impossible: %s", e)
        return None, None, None
    if not exif_data:
        return None, None, None
    gps_info = {}
    timestamp = None
    for tag_id, value in exif_data.items():
        tag = TAGS.get(tag_id, tag_id)
        if tag == "GPSInfo":
            for k, v in value.items():
                gps_info[GPSTAGS.get(k, k)] = v
        elif tag in ("DateTime", "DateTimeOriginal"):
            try:
                timestamp = datetime.strptime(value, "%Y:%m:%d %H:%M:%S")
            except (ValueError, TypeError) as e:
                log.debug("Timestamp EXIF illisible: %s", e)
    if not gps_info:
        return None, None, timestamp
    lat = dms_to_decimal(gps_info.get("GPSLatitude"), gps_info.get("GPSLatitudeRef", "N"))
    lon = dms_to_decimal(gps_info.get("GPSLongitude"), gps_info.get("GPSLongitudeRef", "E"))
    return lat, lon, timestamp


def image_to_b64(path):
    with open(path, "rb") as f:
        return base64.b64encode(f.read()).decode("utf-8")


def picarta_geolocate(path, api_token, top_k=5, country_code=None):
    try:
        image_b64 = image_to_b64(path)
    except OSError as e:
        log.error("Lecture image pour Picarta impossible: %s", e)
        return []
    payload = {"TOKEN": api_token, "IMAGE": image_b64, "TOP_K": top_k}
    if country_code:
        payload["Country"] = country_code
    try:
        response = http_request(
            "POST", "https://picarta.ai/classify",
            json=payload, headers={"Content-Type": "application/json"}, timeout=30,
        )
    except requests.exceptions.HTTPError as e:
        status = e.response.status_code if e.response is not None else None
        codes = {401: "clé invalide", 402: "crédits épuisés", 429: "quota dépassé"}
        log.warning("Picarta HTTP %s: %s", status, codes.get(status, "erreur"))
        return []
    except requests.exceptions.RequestException as e:
        log.warning("Picarta injoignable: %s", e)
        return []
    try:
        data = response.json()
    except ValueError as e:
        log.warning("Réponse Picarta illisible: %s", e)
        return []
    candidates = []
    preds = data.get("topk_predictions_dict", {}) or {}
    for key in sorted(preds.keys(), key=_safe_int):
        pred = preds[key] or {}
        gps = pred.get("gps") or []
        lat = _safe_float(gps[0]) if len(gps) > 0 else None
        lon = _safe_float(gps[1]) if len(gps) > 1 else None
        if lat is None or lon is None:
            continue
        addr = pred.get("address", {}) or {}
        candidates.append({
            "lat": lat,
            "lon": lon,
            "city": addr.get("city", ""),
            "country": addr.get("country", ""),
            "province": addr.get("province", ""),
            "confidence": _safe_float(pred.get("confidence", 0)) or 0.0,
            "source": "Picarta",
        })
    return candidates


def solar_analysis(lat, lon, timestamp):
    try:
        import ephem
    except ImportError:
        return "ephem non installé"
    try:
        observer = ephem.Observer()
        observer.lat, observer.lon = str(lat), str(lon)
        when = timestamp.astimezone(timezone.utc) if timestamp.tzinfo else timestamp
        observer.date = when.strftime("%Y/%m/%d %H:%M:%S")
        sun = ephem.Sun(observer)
        altitude = math.degrees(float(sun.alt))
        azimuth = math.degrees(float(sun.az))
    except (ValueError, TypeError, AttributeError) as e:
        log.debug("Calcul solaire impossible: %s", e)
        return f"Calcul impossible ({e})"
    if altitude < 0:
        return f"Soleil sous horizon ({altitude:.1f}) - nuit"
    return f"Soleil à {altitude:.1f} altitude, azimut {azimuth:.1f}"


def nominatim_geocode(query):
    if is_empty(query) or len(query.strip()) < 3:
        return None, None, None
    nominatim_limiter.wait()
    try:
        response = http_request(
            "GET", "https://nominatim.openstreetmap.org/search",
            params={"q": query, "format": "json", "limit": 1},
            headers={"User-Agent": "osint-geolocate/3.0 (+https://github.com/J0ELAMENACE/osint-geolocate)"},
            timeout=10,
        )
    except requests.exceptions.RequestException as e:
        log.warning("Nominatim injoignable: %s", e)
        return None, None, None
    try:
        results = response.json()
    except ValueError as e:
        log.warning("Réponse Nominatim illisible: %s", e)
        return None, None, None
    if not results:
        return None, None, None
    top = results[0]
    lat = _safe_float(top.get("lat"))
    lon = _safe_float(top.get("lon"))
    if lat is None or lon is None:
        return None, None, None
    return lat, lon, top.get("display_name", query)


def web_search(query, max_results=5):
    if not DDG_AVAILABLE:
        return []
    try:
        with DDGS() as ddgs:
            return list(ddgs.text(query, max_results=max_results))
    except Exception as e:
        log.warning("Recherche DDG échouée: %s", e)
        return []


def ollama_ping():
    try:
        response = requests.get(f"{OLLAMA_HOST}/api/tags", timeout=5)
        response.raise_for_status()
        return True
    except requests.exceptions.RequestException as e:
        log.debug("Ollama ping échoué: %s", e)
        return False


def ollama_call(model, prompt, image_b64=None, timeout=None):
    payload = {"model": model, "prompt": prompt, "stream": False,
               "options": {"temperature": 0.1}}
    if image_b64:
        payload["images"] = [image_b64]
    response = requests.post(f"{OLLAMA_HOST}/api/generate", json=payload,
                             timeout=timeout or OLLAMA_TIMEOUT)
    response.raise_for_status()
    return response.json().get("response", "")


def parse_response(raw):
    clean = re.sub(r"```(?:json)?", "", raw).strip()
    match = re.search(r"\{.*\}", clean, re.DOTALL)
    if match:
        try:
            return json.loads(match.group())
        except json.JSONDecodeError as e:
            log.debug("JSON extrait invalide: %s", e)
    try:
        return json.loads(clean)
    except json.JSONDecodeError as e:
        log.debug("Réponse non-JSON, fallback texte brut: %s", e)
        return {"reasoning": raw}


